{
  "$schema": "https://json.schemas.azure.com/staticwebapp.config.json",
  "mimeTypes": {
    ".json": "application/json",
    ".js": "text/javascript",
    ".css": "text/css",
    ".html": "text/html"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "Cache-Control": "no-store"
  },
  "responseOverrides": {
    "404": { "rewrite": "/index.html" }
  }
}
